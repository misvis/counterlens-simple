{
  "name": "counter-lens-simple",
  "homepage": "https://misvis.github.io/counterlens-simple/",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:web:api\"",
    "dev:web": "vite",
    "dev:web:api": "cross-env VITE_API_BASE_URL=http://127.0.0.1:8787 vite",
    "dev:server": "node --watch server/index.js",
    "start:server": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test server/app.test.js",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll -r https://github.com/misvis/counterlens-simple.git"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "lucide": "^0.563.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  }
}
