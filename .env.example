# CounterLens API
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated browser origins. A URL path is not part of an origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://misvis.github.io

# Required to read /api/v1/monitoring/summary. Use a long random value in production.
MONITORING_TOKEN=replace-with-a-long-random-token
MONITORING_DB_PATH=server/.data/monitoring.sqlite
MONITORING_RETENTION_DAYS=30

# Optional Vite build-time settings for a deployed API. `npm run dev` already
# points the local frontend to http://127.0.0.1:8787.
# VITE_API_BASE_URL=https://your-approved-umbc-api.example.edu
# VITE_DATASET_ID=admissions-demo
